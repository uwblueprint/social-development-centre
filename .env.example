# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API. Use sdc-dev locally, never sdc-prod.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Supabase → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=

# Membership payments (docs/backend/payments.md). All server only.
# "sandbox" (default) or "live". Sandbox and live each have their own app, keys, webhook and plans.
PAYPAL_ENV=sandbox
# developer.paypal.com → Apps & Credentials → your app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The app's webhook (pointing at /api/webhooks/paypal) → Webhook ID.
PAYPAL_WEBHOOK_ID=
# PayPal → Subscriptions → Plans: the Plan id (starts with "P-") for each plan in src/features/payments/config.ts.
PAYPAL_PLAN_ID_INDIVIDUAL=
# Outgoing email (automatic emails): the sdcentre@uwblueprint.org Gmail account, the same one
# Supabase uses for sign-in emails. Leave blank to log emails instead of sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sdcentre@uwblueprint.org
# The Gmail app password. Vercel hides it once saved; ask whoever set it up, or make a new one.
SMTP_PASSWORD=
# Outside production, only these comma-separated addresses really receive mail; everyone else is
# logged, so a local run against sdc-dev can't email real members.
EMAIL_TEST_ALLOWLIST=

# Any long random string (e.g. `openssl rand -hex 32`). Vercel sends it with each cron call.
CRON_SECRET=
